{% extends "_layouts/cp" %}

{% set title = "Links"|t('short-io') %}
{% set selectedSubnavItem = 'links' %}

{# Craft.VueAdminTable is what the CP's own settings listings are built from -
   Sections, Fields, Filesystems - so it brings the toolbar, search, sorting,
   pagination and delete confirmation with it. Element indexes are for elements;
   short links aren't, so this is the right listing to be. #}
{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% do view.registerTranslations('short-io', [
    'Are you sure you want to delete “{name}”? The short link will stop working immediately.',
    'Clicks (30d)',
    'Created',
    'Destination',
    'Entry',
    'link',
    'links',
    'No short links match that search.',
    'No short links yet.',
    'Re-sync',
    'Search links',
    'Short link',
]) %}

{% block content %}
    {% if not settings.isConfigured() %}
        <blockquote class="note warning">
            {{ "Short.io isn't connected yet."|t('short-io') }}
            <a href="{{ url('short-io/settings') }}">{{ "Add an API key and domain"|t('short-io') }}</a>.
        </blockquote>
    {% endif %}

    <div class="instructions short-io-intro">
        <p>{{ "Click counts come from a local snapshot, refreshed in the background as this screen is used, so they can lag a few minutes behind Short.io."|t('short-io') }}</p>
    </div>

    <div id="short-io-links"></div>
{% endblock %}

{% css %}
    /* Craft's .instructions is sized for the inside of a field shell, so a
       standalone one needs the space between paragraphs putting back. */
    .short-io-intro {
        margin-block-end: var(--l);
    }
{% endcss %}

{% js %}
    (() => {
        const columns = [
            { name: '__slot:title', title: Craft.t('short-io', 'Short link'), sortField: true },
            { name: 'entry', title: Craft.t('short-io', 'Entry') },
            { name: 'destination', title: Craft.t('short-io', 'Destination') },
            { name: 'clicks', title: Craft.t('short-io', 'Clicks (30d)'), sortField: true },
            { name: 'dateCreated', title: Craft.t('short-io', 'Created'), sortField: true },
        ];

        const config = {
            columns,
            container: '#short-io-links',
            emptyMessage: Craft.t('short-io', 'No short links yet.'),
            noSearchResults: Craft.t('short-io', 'No short links match that search.'),
            search: true,
            searchPlaceholder: Craft.t('short-io', 'Search links'),
            tableDataEndpoint: 'short-io/links/table-data',
            // There's a notice above the table and a note below it, so the
            // table isn't the only thing in this pane.
            fullPane: false,
            perPage: {{ perPage }},
            itemLabels: {
                singular: Craft.t('short-io', 'link'),
                plural: Craft.t('short-io', 'links'),
            },
        };

        {% if canManage %}
            config.checkboxes = true;
            config.actions = [
                {
                    label: Craft.t('short-io', 'Re-sync'),
                    action: 'short-io/links/resync',
                    ajax: true,
                    allowMultiple: true,
                },
            ];
            config.deleteAction = 'short-io/links/delete';
            config.deleteConfirmationMessage = Craft.t('short-io', 'Are you sure you want to delete “{name}”? The short link will stop working immediately.');
        {% endif %}

        new Craft.VueAdminTable(config);
    })();
{% endjs %}

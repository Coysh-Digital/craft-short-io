{% import "_includes/forms" as forms %}

{# Mirrors Element::statusFieldHtml(): a <fieldset> with an <legend class="h6">,
   then a .meta panel of fields. Craft lays those rows out label-left through
   `.details .meta > .field`, so every row has to be a direct child of a .meta -
   nesting one deeper is what makes a hand-built panel look subtly unlike the
   native ones. Read-only values go in a second, .read-only panel: the same
   <dl class="meta read-only"> Cp::metadataHtml() builds. #}
<fieldset id="short-io-field">
    <legend class="h6">{{ "Short link"|t('short-io') }}</legend>

    {% if not domain %}
        <div class="meta">
            <div class="field">
                <p class="light">
                    <a href="{{ url('short-io/settings') }}">{{ "Connect Short.io"|t('short-io') }}</a>
                    {{ "to start creating short links."|t('short-io') }}
                </p>
            </div>
        </div>
    {% else %}
        <div class="meta">
            {% if link %}
                {# Rendered only when a link exists. This is the only way to tell
                   "the editor cleared the path" from "there was never a path" -
                   both post an empty shortIoPath. #}
                <input type="hidden" name="shortIoLinkPresent" value="1">
            {% endif %}

            {# The domain is the label, so the row reads as one short URL split
               across the two columns, the way Craft's own Slug row does.

               With automatic links off, saving with a blank field makes no link
               at all, so the placeholder says "none" rather than promising an
               "auto" that never happens.

               info-icon-instructions is what Craft 5 keys its instructions-to-
               info-icon conversion on. The page does that for every sidebar
               field through a #details selector, but a panel swapped in by the
               Create button is initialised on its own, where that ancestor
               can't be seen - so the class has to be on the field itself. #}
            {{ forms.textField({
                label: domain,
                id: 'shortIoPath',
                name: 'shortIoPath',
                fieldClass: 'info-icon-instructions',
                value: path,
                placeholder: link or settings.autoPath ? "auto"|t('short-io') : "none"|t('short-io'),
                instructions: link
                    ? "Clear to remove this short link."|t('short-io')
                    : (not settings.autoPath and canManage ? "Type a path, or leave blank to use the slug, then create the link."|t('short-io') : null),
                disabled: not canManage,
                errors: entry.getErrors('shortIoPath'),
            }) }}

            {# Creates the link there and then, for the canonical entry, so it
               doesn't wait on a save. Offered whenever there is no link yet -
               with automatic links off that is the normal way to get one, and
               with them on it catches entries that predate the plugin. #}
            {% if not link and canManage %}
                <div class="field">
                    <div class="heading"></div>
                    <div class="input ltr">
                        {{ tag('button', {
                            type: 'button',
                            class: ['btn', 'small']|merge(canCreate ? [] : ['disabled']),
                            disabled: not canCreate,
                            text: "Create short link"|t('short-io'),
                            data: {
                                'short-io-create': true,
                                'entry-id': entry.canonicalId,
                                'site-id': entry.siteId,
                            },
                        }) }}
                        {% if not canCreate %}
                            <p class="light smalltext">{{ "Available once this entry is published."|t('short-io') }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        {% set metadata = [] %}

        {% if link %}
            {% set metadata = metadata|merge([{
                label: "Link"|t('short-io'),
                value: include('short-io/_sidebar/_link-value.twig', { link: link }),
            }]) %}
        {% endif %}

        {% if link and link.suspended %}
            {% set metadata = metadata|merge([{
                label: "Status"|t('short-io'),
                value: tag('span', { class: 'status expired' }) ~
                    ("Expired until this entry is published again"|t('short-io')),
            }]) %}
        {% endif %}

        {% if clicks %}
            {% set metadata = metadata|merge([{
                label: "Clicks (30d)"|t('short-io'),
                value: clicks.totalClicks|number_format
                    ~ (clicks.humanClicks != clicks.totalClicks
                        ? ' · ' ~ "{n} human"|t('short-io', { n: clicks.humanClicks|number_format })
                        : ''),
            }]) %}
        {% endif %}

        {% if qrUrl %}
            {# Its own row rather than a third control on the link row: the
               sidebar is narrow, and a long short URL would push it onto a
               line of its own anyway. #}
            {% set qrSize = settings.qrViewMode == 'full' ? 160 : 48 %}
            {% set metadata = metadata|merge([{
                label: "QR code"|t('short-io'),
                value: tag('a', {
                    href: actionUrl('short-io/qr/download', { linkId: link.linkIdString }),
                    title: "Download QR code"|t('short-io'),
                    html: tag('img', {
                        src: qrUrl,
                        alt: "QR code"|t('short-io'),
                        width: qrSize,
                        height: qrSize,
                        style: 'display:block',
                    }),
                }),
            }]) %}
        {% endif %}

        {% if metadata|length %}
            <dl class="meta read-only">
                {% for row in metadata %}
                    <div class="data">
                        <dt class="heading">{{ row.label }}</dt>
                        <dd class="value">{{ row.value|raw }}</dd>
                    </div>
                {% endfor %}
            </dl>
        {% endif %}

        {# Campaign tracking, collapsed so the sidebar stays readable. The
           summary line makes it obvious when something is set without having to
           open it, and the body is another .meta so its fields get the same
           label-left rows as everything above. #}
        {% set utmSummary = [] %}
        {% for k in utmKeys %}
            {% set v = utm[k] ?: utmDefaults[k] %}
            {% if v %}{% set utmSummary = utmSummary|merge([v]) %}{% endif %}
        {% endfor %}

        <details class="short-io-utm">
            <summary>
                {{ "Campaign tracking"|t('short-io') }}
                {% if not utmEnabled %}
                    <span class="light">&middot; {{ "off"|t('short-io') }}</span>
                {% elseif utmSummary|length %}
                    <span class="light">&middot; {{ utmSummary|join(' / ')|slice(0, 40) }}</span>
                {% else %}
                    <span class="light">&middot; {{ "none"|t('short-io') }}</span>
                {% endif %}
            </summary>

            <div class="meta">
                {{ forms.lightswitchField({
                    label: "Add campaign tracking"|t('short-io'),
                    name: 'shortIoUtm[enabled]',
                    on: utmEnabled,
                    disabled: not canManage,
                }) }}

                {% for k in utmKeys %}
                    {{ forms.textField({
                        label: 'utm_' ~ k,
                        name: 'shortIoUtm[' ~ k ~ ']',
                        value: utm[k],
                        placeholder: utmDefaults[k] ?: "none"|t('short-io'),
                        disabled: not canManage,
                    }) }}
                {% endfor %}
            </div>
        </details>
    {% endif %}
</fieldset>

{% css %}
    /* Craft draws the disclosure marker on <details> nowhere in the CP, so this
       panel brings its own - the native one indents the summary past every
       label in the panel. Everything else here is Craft's own .meta styling. */
    #short-io-field .short-io-utm > summary {
        cursor: pointer;
        padding: 10px 0;
        list-style: none;
        color: var(--gray-600);
    }
    #short-io-field .short-io-utm > summary::-webkit-details-marker {
        display: none;
    }
    #short-io-field .short-io-utm > summary::before {
        content: '\25B8';
        display: inline-block;
        width: 12px;
        color: var(--fg-subtle);
    }
    #short-io-field .short-io-utm[open] > summary::before {
        content: '\25BE';
    }
    #short-io-field .short-io-utm[open] > summary {
        padding-bottom: 0;
    }

    /* The link row is a value, a copy button and a QR shortcut on one line. */
    #short-io-field .short-io-link {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--2xs) var(--xs);
    }
    /* A short URL that won't fit beside the buttons keeps the line to itself
       rather than breaking mid-word. */
    #short-io-field .short-io-link > a:first-child {
        overflow-wrap: break-word;
        max-width: 100%;
    }
    #short-io-field .short-io-link .btn {
        flex: 0 0 auto;
    }
{% endcss %}

{# {% js %} rather than a <script> tag: the control panel loads jQuery and
   Garnish at the end of <body>, so an inline script inside sidebar markup would
   run before they exist. The copy button is Craft's own - a .btn with
   data-icon="clipboard" - and answers with Craft's own notice. #}
{% js %}
    // Delegated from the document rather than bound to the buttons, because
    // the Create button swaps the whole panel out for a freshly rendered one
    // and this block doesn't run again for it.
    if (!window.shortIoSidebarBound) {
        window.shortIoSidebarBound = true;

        document.addEventListener('click', function(event) {
            var copy = event.target.closest('#short-io-field [data-short-io-copy]');

            if (copy) {
                var value = copy.getAttribute('data-short-io-copy');
                var done = function() {
                    Craft.cp.displayNotice('{{ "Copied to clipboard."|t('app')|e('js') }}');
                };

                if (navigator.clipboard) {
                    navigator.clipboard.writeText(value).then(done);
                    return;
                }

                var input = document.createElement('input');
                input.value = value;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                done();
                return;
            }

            var create = event.target.closest('#short-io-field [data-short-io-create]');

            if (!create || create.disabled || create.classList.contains('loading')) {
                return;
            }

            // Send what the panel currently holds, so a path typed or a
            // campaign value set before pressing the button is the one used.
            // The request goes as JSON, so shortIoUtm[source] has to be nested
            // by hand - Craft won't unpick a bracketed key the way it does a
            // form post.
            var panel = create.closest('#short-io-field');
            var data = {
                entryId: create.getAttribute('data-entry-id'),
                siteId: create.getAttribute('data-site-id'),
            };

            panel.querySelectorAll('input[name^="shortIo"]').forEach(function(field) {
                if (field.disabled) {
                    return;
                }

                var match = field.name.match(/^(\w+)\[(\w+)\]$/);

                if (match) {
                    data[match[1]] = data[match[1]] || {};
                    data[match[1]][match[2]] = field.value;
                } else {
                    data[field.name] = field.value;
                }
            });

            create.classList.add('loading');

            Craft.sendActionRequest('POST', 'short-io/links/create', { data: data })
                .then(function(response) {
                    var wrapper = document.createElement('div');
                    wrapper.innerHTML = response.data.html;
                    var fresh = wrapper.firstElementChild;
                    panel.replaceWith(fresh);
                    // Craft wires up info icons and the like on page load only,
                    // so the new panel needs the same treatment.
                    Craft.initUiElements($(fresh));
                    Craft.cp.displaySuccess(response.data.message);
                })
                .catch(function(error) {
                    create.classList.remove('loading');
                    var message = error && error.response && error.response.data && error.response.data.message;
                    Craft.cp.displayError(message || '{{ "Short.io couldn’t create the short link."|t('short-io')|e('js') }}');
                });
        });
    }
{% endjs %}

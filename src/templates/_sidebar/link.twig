{% import "_includes/forms" as forms %}

{# Mirrors Craft's own sidebar groups: <fieldset><legend class="h6">, then a
   .meta wrapper. Anything else picks up the wrong heading style. #}
<fieldset id="short-io-field">
    <legend class="h6">{{ "Short link"|t('short-io') }}</legend>
    <div class="meta">
        <div class="field">
        {% if not domain %}
            <p class="light">
                <a href="{{ url('short-io/settings') }}">{{ "Connect Short.io"|t('short-io') }}</a>
                {{ "to start creating short links."|t('short-io') }}
            </p>
        {% else %}
            {% if link %}
                {# Rendered only when a link exists. This is the only way to tell
                   "the editor cleared the path" from "there was never a path" -
                   both post an empty shortIoPath. #}
                <input type="hidden" name="shortIoLinkPresent" value="1">

                <p style="margin-bottom:8px">
                    <a href="{{ link.shortUrl }}" rel="noopener" target="_blank">{{ link.shortUrl }}</a>
                    <button type="button" class="btn small" data-short-io-copy="{{ link.shortUrl }}">{{ "Copy"|t('short-io') }}</button>
                </p>

                {% if link.suspended %}
                    <p class="light" style="margin-bottom:8px">
                        <span class="status orange"></span>
                        {{ "Expired while this entry isn't live. It comes back when the entry is published."|t('short-io') }}
                    </p>
                {% endif %}
            {% endif %}

            {{ forms.text({
                id: 'shortIoPath',
                name: 'shortIoPath',
                value: link ? link.path : '',
                placeholder: "auto"|t('short-io'),
                disabled: not canManage,
                title: domain,
            }) }}
            <p class="light" style="margin-top:4px">
                {%- if link -%}
                    {{ "clear this to remove the short link"|t('short-io') }}
                {%- else -%}
                    {{ domain }}/<strong>{{ "path"|t('short-io') }}</strong>
                {%- endif -%}
            </p>

            {% if clicks %}
                <p class="light" style="margin-top:8px">
                    {{ "{n} clicks in the last 30 days"|t('short-io', { n: clicks.totalClicks|number_format }) }}
                    {%- if clicks.humanClicks != clicks.totalClicks %}
                        &middot; {{ "{n} human"|t('short-io', { n: clicks.humanClicks|number_format }) }}
                    {%- endif %}
                </p>
            {% endif %}

            {% if qrUrl %}
                <p style="margin-top:8px">
                    {# The image URL is public, so this is a plain remote <img>. #}
                    <a href="{{ actionUrl('short-io/qr/download', { linkId: link.linkIdString }) }}"
                       title="{{ 'Download QR code'|t('short-io') }}">
                        <img src="{{ qrUrl }}" alt="{{ 'QR code'|t('short-io') }}"
                             style="{{ settings.qrViewMode == 'full' ? 'max-width:160px;height:auto' : 'width:48px;height:48px' }};display:block">
                    </a>
                </p>
            {% endif %}
        {% endif %}
        </div>
            {% if domain %}
        {# Campaign tracking, collapsed so the sidebar stays readable. The
           summary line makes it obvious when something is set without
           having to open it. #}
        {% set utmSummary = [] %}
        {% for k in utmKeys %}
            {% set v = utm[k] ?: utmDefaults[k] %}
            {% if v %}{% set utmSummary = utmSummary|merge([v]) %}{% endif %}
        {% endfor %}

        <details class="short-io-utm">
            <summary>
                {{ "Campaign tracking"|t('short-io') }}
                {% if not utmEnabled %}
                    <span class="light">&middot; {{ "off"|t('short-io') }}</span>
                {% elseif utmSummary|length %}
                    <span class="light">&middot; {{ utmSummary|join(' / ')|slice(0, 40) }}</span>
                {% else %}
                    <span class="light">&middot; {{ "none"|t('short-io') }}</span>
                {% endif %}
            </summary>

            <div class="short-io-utm-body">
                {{ forms.lightswitchField({
                    label: "Add campaign tracking"|t('short-io'),
                    name: 'shortIoUtm[enabled]',
                    on: utmEnabled,
                    disabled: not canManage,
                }) }}

                {% for k in utmKeys %}
                    {{ forms.textField({
                        label: 'utm_' ~ k,
                        name: 'shortIoUtm[' ~ k ~ ']',
                        value: utm[k],
                        placeholder: utmDefaults[k] ?: "none"|t('short-io'),
                        disabled: not canManage,
                    }) }}
                {% endfor %}

                <p class="light">
                    {{ "Leave a field blank to use the site default shown in it."|t('short-io') }}
                </p>
            </div>
        </details>
        {% endif %}
    </div>
</fieldset>

{% css %}
    /* Craft's sidebar rows full-bleed the panel and inset their content by 14px
       horizontally and 12px vertically - but it does that with direct-child
       selectors, so fields nested inside this fieldset miss the rule entirely
       and end up flush against the edges. Restate the inset here so this panel
       sits on the same grid as the Slug and Status rows above it. */
    #short-io-field > .meta > .field {
        padding: 12px 14px;
    }

    #short-io-field .short-io-utm-body .field > .heading,
    #short-io-field .short-io-utm-body .field > .input,
    #short-io-field .short-io-utm-body > p,
    #short-io-field .short-io-utm > summary {
        padding-left: 14px;
        padding-right: 14px;
    }

    /* The sidebar is narrow, so keep inputs inside the padded area. */
    #short-io-field input[type="text"] {
        width: 100%;
        box-sizing: border-box;
    }

    /* Craft gives a standalone field 24px of separation, which is far too much
       stacked five times in a sidebar. */
    #short-io-field .short-io-utm-body .field {
        margin-bottom: 0;
        padding-top: 4px;
        padding-bottom: 4px;
    }
    #short-io-field .short-io-utm-body .field > .heading {
        padding-bottom: 2px;
    }
    #short-io-field .short-io-utm-body .field > .heading label {
        font-weight: normal;
    }

    /* Draw our own disclosure marker: the native one indents the summary text
       past everything else in the panel. */
    #short-io-field .short-io-utm > summary {
        cursor: pointer;
        padding-top: 10px;
        padding-bottom: 10px;
        list-style: none;
        /* Craft's .field rows carry a -24px margin so they full-bleed the
           panel; the summary isn't a .field, so it needs the same pull to line
           up with the labels underneath it. Left only - pulling the right edge
           out as well overflows the panel once the CP stacks on a narrow
           screen. */
        margin-left: -24px;
    }
    #short-io-field .short-io-utm > summary::-webkit-details-marker {
        display: none;
    }
    #short-io-field .short-io-utm > summary::before {
        content: '\25B8';
        display: inline-block;
        width: 12px;
        color: #7d8590;
    }
    #short-io-field .short-io-utm[open] > summary::before {
        content: '\25BE';
    }

    /* Craft lays a sidebar lightswitch out as label-left, switch-right. That's
       a direct-child rule too, so restate it rather than letting ours stack. */
    #short-io-field .short-io-utm-body .lightswitch-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    #short-io-field .short-io-utm-body .lightswitch-field > .heading {
        padding-bottom: 0;
        margin-bottom: 0;
    }
    #short-io-field .short-io-utm[open] > summary {
        padding-bottom: 4px;
    }
    #short-io-field .short-io-utm-body {
        padding-bottom: 12px;
    }
    #short-io-field .short-io-utm-body > p {
        margin: 8px 0 0 -24px;
        padding-left: 14px;
    }
{% endcss %}

{# {% js %} rather than a <script> tag: the control panel loads jQuery and
   Garnish at the end of <body>, so an inline script inside sidebar markup would
   run before they exist. #}
{% js %}
    document.querySelectorAll('#short-io-field [data-short-io-copy]').forEach(function(button) {
        button.addEventListener('click', function() {
            var value = button.getAttribute('data-short-io-copy');
            var done = function() {
                var original = button.textContent;
                button.textContent = '{{ "Copied"|t('short-io')|e('js') }}';
                setTimeout(function() { button.textContent = original; }, 1500);
            };

            if (navigator.clipboard) {
                navigator.clipboard.writeText(value).then(done);
                return;
            }

            var input = document.createElement('input');
            input.value = value;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            done();
        });
    });
{% endjs %}
